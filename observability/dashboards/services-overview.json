      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Latency, average and slowest",
      "description": "Average and recent maximum. The services do not publish latency histograms, so there are no percentiles.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace) (rate(http_server_requests_seconds_sum{namespace=~\"$namespace\", uri!~\"/actuator.*\"}[$__rate_interval])) / sum by (namespace) (rate(http_server_requests_seconds_count{namespace=~\"$namespace\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}} average"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (namespace) (http_server_requests_seconds_max{namespace=~\"$namespace\", uri!~\"/actuator.*\"})",
          "legendFormat": "{{namespace}} slowest"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "id": 8
