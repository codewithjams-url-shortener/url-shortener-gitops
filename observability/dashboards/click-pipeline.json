    {
      "type": "timeseries",
      "title": "Age of a click event when acknowledged",
      "description": "The delay from the click to its stats being counted. Alert when the 95th percentile exceeds 60s for 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(sqs_consumer_event_age_seconds_bucket[$__rate_interval])))",
          "legendFormat": "median"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sqs_consumer_event_age_seconds_bucket[$__rate_interval])))",
          "legendFormat": "95th percentile"
        }
      ],
